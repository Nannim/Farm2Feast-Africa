{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the system (Customer, Vendor, or Admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "vendor", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "A food staple item sold by a vendor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendorId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "stock": { "type": "number" },
        "unit": { "type": "string", "description": "e.g., kg, bag, liter" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendorId", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer's purchase.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "vendorId": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" },
              "name": { "type": "string" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "transportCost": { "type": "number" },
        "commission": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "shippingAddress": { "type": "string" },
        "customerPhone": { "type": "string" }
      },
      "required": ["customerId", "items", "totalAmount", "status"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Detailed vendor profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "businessName": { "type": "string" },
        "description": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "totalSales": { "type": "number" },
        "payoutBalance": { "type": "number" }
      },
      "required": ["uid", "businessName"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles" },
    "/products/{productId}": { "schema": "Product", "description": "Product listings" },
    "/orders/{orderId}": { "schema": "Order", "description": "Customer orders" },
    "/vendors/{uid}": { "schema": "Vendor", "description": "Vendor specific details" }
  }
}
